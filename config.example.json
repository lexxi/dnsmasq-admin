{
  "dnsmasq_conf": "/etc/dnsmasq.d/dhcp-reservations.conf",
  "hosts_file": "/etc/hosts",
  "leases_file": "/var/lib/misc/dnsmasq.leases",
  "generate_hosts_script": "/opt/scripts/convert_hosts.sh",
  "reload_cmd": "systemctl reload dnsmasq",
  "backup_dir": "/var/backups/dnsmasq-admin",
  "overview_cidr": "192.168.1.0/24",
  "show_leases_in_overview": true,
  "force_lease_reassign_on_move": true,
  "stop_cmd": "systemctl stop dnsmasq",
  "start_cmd": "systemctl start dnsmasq",
  "allow_sudo": false,
  "segments": [
    {
      "name": "Network",
      "color": "#93c5fd",
      "start_ip": "192.168.1.2",
      "size": 8,
      "hostname_prefix": "net"
    },
    {
      "name": "Linux",
      "color": "#86efac",
      "start_ip": "192.168.1.20",
      "size": 10,
      "hostname_prefix": "linux"
    },
    {
      "name": "Clients",
      "color": "#fecaca",
      "start_ip": "192.168.1.50",
      "size": 30,
      "hostname_prefix": "client"
    },
    {
      "name": "IoT",
      "color": "#fde047",
      "start_ip": "192.168.1.100",
      "size": 30,
      "hostname_prefix": "iot"
    }
  ]
}
